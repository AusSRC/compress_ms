FROM alxndrwllmsn/casacore

# copy source code
COPY  ./ /code/compress_ms/

# ensure we can find boost
ENV BOOST_ROOT=/usr/local

# build compress_ms
RUN cd /code/compress_ms \
    && cmake -B build . -DCMAKE_BUILD_TYPE=Release -G Ninja \
    && cmake --build build --config Release \
    && cmake --install build --config Release \
    && mkdir /workspace

# set workspace and default entrypoint
WORKDIR /workspace
ENTRYPOINT [ "compress_ms" ]

