FROM alxndrwllmsn/ubuntu-base

# build zfp
RUN mkdir /code \
    && cd /code \
    && git clone https://github.com/LLNL/zfp \
    && cd zfp \
    && cmake -B build . -DCMAKE_BUILD_TYPE=Release -G Ninja \
    && cmake --build build --config Release \
    && cmake --install build --config Release

# build mgard
RUN cd /code \
    &&git clone https://github.com/CODARcode/mgard \
    && cd mgard/build_scripts \
    && sed -i "s/install_dir=.\/install-openmp-cpu/install_dir=\/usr\/local/g" build_mgard_openmp_cpu.sh \
    && cd .. \
    && ./build_scripts/build_mgard_openmp_cpu.sh 12

# build adios2
RUN cd /code \
    && git clone https://github.com/ornladios/ADIOS2 \
    && cd ADIOS2 \
    && cmake -B build . -G Ninja \
        -DBUILD_SHARED_LIBS=ON \
        -DADIOS2_BUILD_EXAMPLES=OFF \
        -DADIOS2_USE_MPI=ON \
        -DADIOS2_USE_MGARD=ON \
        -DADIOS2_USE_ZFP=ON \
        -DADIOS2_USE_SZ=OFF \
        -DADIOS2_USE_ZSTD=ON \
        -DADIOS2_USE_DataMan=ON \
        -DADIOS2_USE_SST=ON \
        -DADIOS2_USE_HDF5=OFF \
        -DADIOS2_USE_Python=OFF \
        -DADIOS2_USE_Fortran=ON \
        -DADIOS2_USE_Endian_Reverse=OFF \
        -DBUILD_TESTING:BOOL=OFF \
        -DADIOS2_USE_Blosc=OFF \
        -DADIOS2_USE_BZip2=ON \
        -DADIOS2_USE_PNG=OFF \
        -DADIOS2_USE_SSC=ON \
        -DADIOS2_USE_DataSpaces=OFF \
        -DADIOS2_USE_IME=OFF \
    && cmake --build build \
    && cmake --install build