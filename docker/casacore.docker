#     && ./b2 \
#     && ./b2 install

RUN . /code/venv/bin/activate \
    && cd /code/casacore \
    && cmake -B build -G Ninja . \
    -DBUILD_TESTING=OFF \
    -DUSE_OPENMP=ON \
    -DUSE_HDF5=ON \
    -DUSE_ADIOS2=ON \
    -DUSE_MPI=ON \
    -DUSE_PCH=ON \
    -DCMAKE_PREFIX_PATH=${CMAKE_PREFIX_PATH} \
    -DDATA_DIR=/usr/local/share/casacore/data \
    -DENABLE_SHARED=ON \
    -DUSE_READLINE=ON \
    -DENABLE_TABLELOCKING=OFF \
    -DBUILD_PYTHON3=YES \
    -DBUILD_PYTHON=NO \
    && cmake --build build \
    && cmake --install build \
    && ldconfig

RUN cd /code \
    && . venv/bin/activate \
    && pip install --no-binary python-casacore python-casacore \
    && scp -r /usr/local/lib/python3.12/dist-packages /code/venv/lib/python3.12/