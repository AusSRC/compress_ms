FROM ${USER}/adios2

RUN cd /code \
    && git clone https://github.com/rtobar/cfitsio -b stream_funcs_renamed \
    && cd cfitsio \
    && cmake -B build . -G Ninja  \
    && cmake --build build \
    && cmake --install build \
    && ldconfig

RUN wget -nv -O /WSRT_Measures.ztar https://www.astron.nl/iers/WSRT_Measures.ztar \
    && mkdir -p /usr/local/share/casacore/data \
    && cd /usr/local/share/casacore/data \
    && tar xfz /WSRT_Measures.ztar \
    && rm /WSRT_Measures.ztar

#temp dependency matching
RUN apt-get update \
    && apt-get install -y \
        libreadline-dev \
        python3-dev \
        libboost-all-dev

RUN cd /code \
    && python3 -m venv venv \
    && . venv/bin/activate \
    && pip install numpy \
    && rm -rf casacore \
    && git clone https://github.com/rtobar/casacore.git \
    && cd casacore && git checkout adios2stman-rows-readwrite

# RUN cd /code \
#     && . venv/bin/activate \
#     && git clone https://github.com/boostorg/boost.git -b boost-1.89.0 boost_1_89_0 --depth 1 \
#     && cd boost_1_89_0 \
#     && git submodule update --depth 1 -q --init tools/boostdep \
