FROM ${USER}/adios2

# build custom cfitsio (interferes with zfp)
RUN cd /code \
    && git clone https://github.com/rtobar/cfitsio -b stream_funcs_renamed \
    && cd cfitsio \
    && cmake -B build . -G Ninja  \
    && cmake --build build \
    && cmake --install build \
    && ldconfig

# download and unpack casacore measures tables
RUN wget -nv -O /WSRT_Measures.ztar https://www.astron.nl/iers/WSRT_Measures.ztar \
    && mkdir -p /usr/local/share/casacore/data \
    && cd /usr/local/share/casacore/data \
    && tar xfz /WSRT_Measures.ztar \
    && rm /WSRT_Measures.ztar

# set up python environment and get custom casacore (fixes issues with ADIOS2 Storage manager)
RUN cd /code \
    && python3 -m venv venv \
    && . venv/bin/activate \
    && pip install numpy \
    && rm -rf casacore \
    && git clone https://github.com/rtobar/casacore.git \
    && cd casacore && git checkout adios2stman-rows-readwrite

# build casacore
RUN . /code/venv/bin/activate \
    && cd /code/casacore \
    && cmake -B build -G Ninja . \
    -DBUILD_TESTING=OFF \
    -DUSE_OPENMP=ON \
    -DUSE_HDF5=ON \
    -DUSE_ADIOS2=ON \
    -DUSE_MPI=ON \
    -DUSE_PCH=ON \
    -DCMAKE_PREFIX_PATH=${CMAKE_PREFIX_PATH} \
    -DDATA_DIR=/usr/local/share/casacore/data \
    -DENABLE_SHARED=ON \
    -DUSE_READLINE=ON \
    -DENABLE_TABLELOCKING=OFF \
    -DBUILD_PYTHON3=YES \
    -DBUILD_PYTHON=NO \
    && cmake --build build \
    && cmake --install build \
    && ldconfig

# build python-casacore
RUN cd /code \
    && . venv/bin/activate \
    && pip install --no-binary python-casacore python-casacore \
    && scp -r /usr/local/lib/python3.12/dist-packages /code/venv/lib/python3.12/