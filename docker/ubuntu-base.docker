FROM ubuntu:24.04

# base dependencies
RUN  apt-get update \
    && apt-get install -y \
    gcc \
    g++ \
    cmake \
    ninja-build \
    git \
    libblas-dev \
    liblapack-dev \
    wcslib-dev \
    libfftw3-dev \
    libhdf5-serial-dev \
    python3.12-venv \
    libgsl-dev \
    pkg-config \
    bzip2 \
    flex \
    bison \
    libomp-dev \
    libopenmpi-dev \
    libbz2-dev \
    libreadline-dev \
    python3-dev \
    libboost-all-dev \
    wget 